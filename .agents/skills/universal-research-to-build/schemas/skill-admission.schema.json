{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Admission",
  "type": "object",
  "required": ["skill_id", "status", "reason"],
  "properties": {
    "skill_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["admit", "admit_with_conditions", "abstain", "quarantine", "reject"]},
    "reason": {"type": "string", "minLength": 1},
    "provenance_refs": {"type": "array", "items": {"type": "string"}},
    "risk_findings": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
